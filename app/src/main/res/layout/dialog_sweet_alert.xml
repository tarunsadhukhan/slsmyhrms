<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sweetRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="300dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_sweet_dialog"
    android:padding="28dp">

    <TextView
        android:id="@+id/tvSweetIcon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_sweet_circle"
        android:gravity="center"
        android:textSize="44sp"
        android:textStyle="bold"
        android:text="!" />

    <TextView
        android:id="@+id/tvSweetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="#575757"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSweetMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="#797979"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnSweetOk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minWidth="120dp"
        android:background="@drawable/bg_sweet_button"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="OK"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
</LinearLayout>
