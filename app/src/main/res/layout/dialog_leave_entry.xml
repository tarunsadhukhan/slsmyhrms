<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Employee Code + Name row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Employee *"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_rounded_light"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/etDialogEmpCode"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:textColor="#000000"
                android:textColorHint="#999999"
                android:hint="Emp code"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnSearchEmp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                app:tint="#1565C0"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search employee" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#CCCCCC" />

            <TextView
                android:id="@+id/tvDialogEmpName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:textColor="#000000"
                android:textSize="13sp"
                android:hint="Name will appear here"
                android:textColorHint="#AAAAAA"
                android:singleLine="true"
                android:ellipsize="end"
                android:focusable="false"
                android:clickable="false" />
        </LinearLayout>

        <!-- Leave Type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leave Type *"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:layout_marginTop="4dp" />

        <Spinner
            android:id="@+id/spDialogLeaveType"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_rounded_light"
            android:paddingStart="8dp"
            android:layout_marginBottom="10dp" />

        <!-- From Date / To Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="From Date *"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/btnDialogFromDate"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_rounded_light"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">

                    <TextView
                        android:id="@+id/tvDialogFromDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:hint="Select"
                        android:textColorHint="#AAAAAA" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#1565C0" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="To Date *"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/btnDialogToDate"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_input_rounded_light"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">

                    <TextView
                        android:id="@+id/tvDialogToDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#000000"
                        android:textSize="13sp"
                        android:hint="Select"
                        android:textColorHint="#AAAAAA" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#1565C0" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- No of Days -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No. of Days"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etDialogDays"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_rounded_light"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:hint="Auto calculated"
            android:inputType="numberDecimal"
            android:focusable="true"
            android:clickable="true"
            android:cursorVisible="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <!-- Reason -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reason"
            android:textColor="#333333"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etDialogReason"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_input_rounded_light"
            android:textColor="#000000"
            android:textColorHint="#AAAAAA"
            android:hint="Enter reason..."
            android:inputType="textMultiLine"
            android:gravity="top|start"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />


    </LinearLayout>
</ScrollView>

