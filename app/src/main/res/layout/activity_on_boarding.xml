<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/toolbar_dark_blue">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_dark_blue"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="@color/white">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On Boarding"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_top_rounded">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Employee Code Search -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter Employee Code"
                    android:textColor="@color/label_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/etEbId"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="Employee Code"
                        android:inputType="text"
                        android:textColorHint="@color/hint_text"
                        android:textColor="@color/black"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="15sp"
                        android:layout_marginEnd="10dp" />

                    <Button
                        android:id="@+id/btnSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Search"
                        android:backgroundTint="@color/toolbar_dark_blue"
                        android:textColor="@color/white"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp" />
                </LinearLayout>

                <!-- Employee Info Card -->
                <LinearLayout
                    android:id="@+id/cardEmployee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvEmpName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Employee Name"
                        android:textColor="@color/toolbar_dark_blue"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvEmpCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Code: -"
                        android:textColor="@color/hint_text"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvDeptDesig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- | -"
                        android:textColor="@color/hint_text"
                        android:textSize="13sp"
                        android:layout_marginBottom="14dp" />

                    <!-- Face count indicators -->
                    <TextView
                        android:id="@+id/tvFaceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Faces Registered: 0 / 3"
                        android:textColor="@color/label_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/dotFace1"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_person"
                            android:layout_marginEnd="8dp" />

                        <ImageView
                            android:id="@+id/dotFace2"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_person"
                            android:layout_marginEnd="8dp" />

                        <ImageView
                            android:id="@+id/dotFace3"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_person" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Camera + Register Card -->
                <LinearLayout
                    android:id="@+id/cardCamera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_stat_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capture Face Photo"
                        android:textColor="@color/label_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <ImageView
                        android:id="@+id/ivFacePreview"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:src="@drawable/ic_person"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_input_rounded"
                        android:layout_marginBottom="16dp"
                        android:visibility="visible" />

                    <Button
                        android:id="@+id/btnCapture"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="📷  Capture Face (live)"
                        android:backgroundTint="@color/toolbar_dark_blue"
                        android:textColor="@color/white"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnRegisterFace"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="✅  Register Face"
                        android:backgroundTint="#2E7D32"
                        android:textColor="@color/white"
                        android:enabled="false" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>
</LinearLayout>

