<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF000000"
    android:padding="4dp">

    <!-- Employee info at top -->
    <TextView
        android:id="@+id/tvPhotoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Captured Photo -->
    <ImageView
        android:id="@+id/ivFullPhoto"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_below="@id/tvPhotoTitle"
        android:layout_centerHorizontal="true"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="Attendance Photo"
        android:padding="8dp" />

    <!-- Date/Time info at bottom -->
    <TextView
        android:id="@+id/tvPhotoInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ivFullPhoto"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:textColor="#B0BEC5"
        android:textSize="13sp" />

</RelativeLayout>

