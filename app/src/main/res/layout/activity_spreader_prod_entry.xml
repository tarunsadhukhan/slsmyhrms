<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F2">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1E1E1E"
        app:titleTextColor="@color/white">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spreader Production Entry"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- ═══ ENTRY CARD ═══ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spreader Production Entry"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1E1E1E"
                        android:layout_marginBottom="12dp" />

                    <!-- ROW 1: Date | Spell -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <LinearLayout
                                android:id="@+id/btnEntryDate"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:clickable="true"
                                android:focusable="true">
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_calendar"
                                    android:layout_marginEnd="6dp"
                                    app:tint="#555555"/>
                                <TextView
                                    android:id="@+id/tvEntryDate"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textColor="#1E1E1E"
                                    android:textSize="14sp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Spell"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <Spinner
                                android:id="@+id/spEntrySpell"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ROW 2: Mc Nos as buttons -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mc No"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="6dp">
                        <LinearLayout
                            android:id="@+id/llMachines"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingBottom="4dp"/>
                    </HorizontalScrollView>
                    <TextView
                        android:id="@+id/tvMachinesStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#777777"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"/>

                    <!-- ROW 3: Quality as buttons -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jute Quality"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="6dp">
                        <LinearLayout
                            android:id="@+id/llQualities"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingBottom="4dp"/>
                    </HorizontalScrollView>
                    <TextView
                        android:id="@+id/tvQualitiesStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#777777"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone"/>

                    <!-- ROW 3b: Spreader Jute Quality as buttons -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spreader Jute Quality"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="6dp">
                        <LinearLayout
                            android:id="@+id/llSprdQualities"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingBottom="4dp"/>
                    </HorizontalScrollView>
                    <TextView
                        android:id="@+id/tvSprdQualitiesStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#777777"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone"/>

                    <!-- ROW 4: Production | Bin No | Save -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="4dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Production"
                                android:textColor="#000000"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <EditText
                                android:id="@+id/etProduction"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:hint="0.000"
                                android:inputType="numberDecimal"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:textSize="13sp"
                                android:textColor="#1E1E1E"
                                android:imeOptions="actionNext"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bin No"
                                android:textColor="#000000"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp"/>
                            <EditText
                                android:id="@+id/etBinNo"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_rounded_light"
                                android:hint="Bin No"
                                android:inputType="text"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:textSize="13sp"
                                android:textColor="#1E1E1E"
                                android:imeOptions="actionDone"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" "
                                android:textSize="11sp"
                                android:layout_marginBottom="3dp"/>
                            <Button
                                android:id="@+id/btnSave"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:text="Save"
                                android:textSize="13sp"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#1565C0"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ═══ ENTRIES LIST CARD ═══ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Entries"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1E1E1E"/>
                        <ImageView
                            android:id="@+id/btnShowStock"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="5dp"
                            android:src="@drawable/ic_report"
                            android:background="@drawable/bg_icon_button"
                            android:contentDescription="Show quality-wise stock"
                            app:tint="#FFFFFF"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:background="#1565C0"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="3" android:text="Mc No"
                            android:textColor="#FFFFFF" android:textStyle="bold"
                            android:textSize="12sp" android:gravity="center"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="3" android:text="Quality"
                            android:textColor="#FFFFFF" android:textStyle="bold"
                            android:textSize="12sp" android:gravity="center"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="3" android:text="Sprd Quality"
                            android:textColor="#FFFFFF" android:textStyle="bold"
                            android:textSize="12sp" android:gravity="center"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="3" android:text="Production"
                            android:textColor="#FFFFFF" android:textStyle="bold"
                            android:textSize="12sp" android:gravity="center"/>
                        <Space android:layout_width="64dp" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvEntries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                    <TextView
                        android:id="@+id/tvEntriesEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No entries for selected date / spell"
                        android:textColor="#999999"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:padding="16dp"
                        android:visibility="gone"/>

                    <ProgressBar
                        android:id="@+id/pbEntries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>